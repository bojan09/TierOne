# Copy this file to .env and fill in your own values.
# See src/shared/lib/env.ts for how these are read/validated.

# Supabase project (Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/migrations, never bundled into the client.
# Required for scripts/emit_content.py (curriculum seeding) and any admin task
# that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used by content-authoring scripts under scripts/ that call an LLM
# to help draft lesson/quiz content. Not required to run the app itself.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
